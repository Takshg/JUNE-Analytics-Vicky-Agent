# Copy to .env and fill in. Any OpenAI-compatible endpoint works.

# Free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Generic key for non-OpenRouter providers (Groq, Gemini, ...). Takes precedence over OPENROUTER_API_KEY.
# LLM_API_KEY=

# Endpoint (default: https://openrouter.ai/api/v1)
# Groq:   https://api.groq.com/openai/v1
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Model (default: nvidia/nemotron-3-super-120b-a12b:free)
# LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# OpenRouter only: comma-separated models tried in order if the primary is rate limited or down
# LLM_FALLBACK_MODELS=xingchen-agi/xing4.0-29b-a4b:free

# Hidden model reasoning (off = faster; on added ~70s per call on free models in testing)
# LLM_REASONING=off

# Cache responses in .llm_cache.sqlite so replays are free (1 = on, 0 = off)
# LLM_CACHE=1

# Public SEO guide page (the Lovable site). Shown as a link in the app sidebar.
# SEO_URL=https://your-guide.lovable.app

# Google Gemini instead of OpenRouter (free tier). Uncomment all three and leave OPENROUTER_API_KEY empty:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your-gemini-key
# LLM_MODEL=gemini-3.5-flash-lite
